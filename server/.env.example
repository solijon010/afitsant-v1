# Afisant POS — Server muhit o'zgaruvchilari
# Nusxalang: cp .env.example .env

# SQLite fayl yo'li (majburiy)
DB_PATH=/path/to/afisant.db

# HTTP port (default: 3001)
PORT=3001

# Remote API URL
REMOTE_API_URL=https://api-restaurant.hisobchim.uz

# Remote WebSocket URL
REMOTE_WS_URL=wss://api-restaurant.hisobchim.uz

# Boshlang'ich API token (ixtiyoriy — /auth/login orqali ham olish mumkin)
# API_TOKEN=

# Branch ID (ixtiyoriy)
# BRANCH_ID=

# CORS origin (default: *)
# CORS_ORIGIN=http://localhost:5173
